<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: MIT -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>NoiseCancellingStack.Manager</AssemblyName>
    <RootNamespace>NoiseCancellingStack</RootNamespace>
    <Product>Noise Cancelling Stack</Product>
    <Authors>JBWortley</Authors>
    <Description>Offline system-wide RNNoise microphone filtering manager for Windows.</Description>
    <RepositoryUrl>https://github.com/JBWortley/jbw-NoiseCancellingStack</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <Version>1.0.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>
</Project>
