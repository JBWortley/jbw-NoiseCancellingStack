<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: MIT -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>NoiseCancellingStack.Manager</AssemblyName>
    <RootNamespace>NoiseCancellingStack</RootNamespace>
    <Product>Noise Cancelling Stack</Product>
    <Authors>JBWortley</Authors>
    <Description>Offline system-wide microphone noise suppression manager for Windows.</Description>
    <RepositoryUrl>https://github.com/JBWortley/jbw-NoiseCancellingStack</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Version>1.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WebRtcApmPluginSha256 Condition="'$(WebRtcApmPluginSha256)' == ''">DEVELOPMENT-BUILD-NO-WEBRTC-PAYLOAD-HASH</WebRtcApmPluginSha256>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>
  <Target Name="GeneratePayloadHashes" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <GeneratedPayloadHashesFile>$(IntermediateOutputPath)GeneratedPayloadHashes.g.cs</GeneratedPayloadHashesFile>
    </PropertyGroup>
    <ItemGroup>
      <_GeneratedPayloadHashLine Include="// &lt;auto-generated /&gt;" />
      <_GeneratedPayloadHashLine Include="namespace NoiseCancellingStack%3B" />
      <_GeneratedPayloadHashLine Include="internal static class GeneratedPayloadHashes" />
      <_GeneratedPayloadHashLine Include="{" />
      <_GeneratedPayloadHashLine Include="    internal const string WebRtcApmPluginSha256 = &quot;$(WebRtcApmPluginSha256)&quot;%3B" />
      <_GeneratedPayloadHashLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile
      File="$(GeneratedPayloadHashesFile)"
      Lines="@(_GeneratedPayloadHashLine)"
      Overwrite="true"
      Encoding="UTF-8" />
    <ItemGroup>
      <Compile Include="$(GeneratedPayloadHashesFile)" />
    </ItemGroup>
  </Target>
</Project>
